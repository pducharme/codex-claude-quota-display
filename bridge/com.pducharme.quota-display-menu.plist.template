<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pducharme.quota-display-menu</string>
  <key>ProgramArguments</key>
  <array>
    <string>__APP_DIR__/Quota Display Menu.app/Contents/MacOS/QuotaDisplayMenu</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/QuotaDisplayMenu.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/QuotaDisplayMenu.error.log</string>
</dict>
</plist>

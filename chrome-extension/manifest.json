{
  "manifest_version": 3,
  "name": "Quota Display — Companion",
  "version": "1.0.2",
  "homepage_url": "https://github.com/pducharme/codex-claude-quota-display#installer-lextension-chrome",
  "description": "Les quotas Codex et Claude de votre Companion Mac, dans Chrome. Client de l’API du Mac source.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {
    "default_title": "Quota Display",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "options_ui": {"page": "popup.html?settings", "open_in_tab": true},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
